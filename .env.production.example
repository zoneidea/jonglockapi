NODE_ENV=production
PORT=3000
API_PREFIX=/api

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jonglock
DB_USER=your-production-db-user
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10

CORS_ORIGINS=https://jonglock.com,https://mng.jonglock.com,https://platform.jonglock.com

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h
MANAGEMENT_REMEMBER_EXPIRES_IN=30d
MOBILE_JWT_EXPIRES_IN=30d

FIELD_ENCRYPTION_KEY=change-this-32-byte-base64-key-value
FIELD_HASH_SECRET=change-this-hmac-secret-value

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
CRON_SECRET=change-this-cron-secret

# Optional Firebase service account config.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
