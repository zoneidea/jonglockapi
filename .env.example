NODE_ENV=development
PORT=3000
API_PREFIX=/api

DB_HOST=27.254.134.22
DB_PORT=3306
DB_NAME=zonedevn_jonglock
DB_USER=zonedevn_jonglock
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h
MOBILE_JWT_EXPIRES_IN=30d

# 32-byte key encoded as base64. Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=change-this-32-byte-base64-key
# Random long secret for blind indexes/search hashes.
FIELD_HASH_SECRET=change-this-hmac-secret

# UAT example:
# CORS_ORIGINS=https://jonglock.zonedevnode.com,https://jonglockmng.zonedevnode.com,http://localhost:5173,http://localhost:3000
# Production example:
# CORS_ORIGINS=https://jonglock.com,https://mng.jonglock.com,https://platform.jonglock.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# app = Express sends Access-Control-Allow-Origin.
# proxy = nginx/Plesk sends Access-Control-Allow-Origin, Express only answers CORS methods/headers.
# If omitted, development/test defaults to app and production defaults to proxy.
CORS_ORIGIN_SOURCE=app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
