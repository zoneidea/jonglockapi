-- READ ONLY; run later using psql -v target_schema=APPROVED_SCHEMA -f this_file
\set ON_ERROR_STOP on
\if :{?target_schema}
\else
  \echo 'STOP: target_schema must be specified explicitly'
  \quit
\endif
BEGIN READ ONLY;
SELECT current_database(), version(), current_setting('TimeZone');
SELECT schema_name FROM information_schema.schemata WHERE schema_name = :'target_schema';

-- Exact counts, not pg_stat estimates. Compare with the immutable source snapshot.
SELECT format('SELECT %L AS table_name, count(*) AS row_count FROM %I.%I;',
 table_name, table_schema, table_name)
FROM information_schema.tables
WHERE table_schema = :'target_schema' AND table_type = 'BASE TABLE' ORDER BY table_name
\gexec

SELECT table_name, column_name, data_type, udt_name, is_nullable, column_default
FROM information_schema.columns WHERE table_schema = :'target_schema'
ORDER BY table_name, ordinal_position;

SELECT c.relname AS table_name, co.conname, co.contype, co.convalidated,
       pg_get_constraintdef(co.oid) AS definition
FROM pg_constraint co JOIN pg_class c ON c.oid = co.conrelid
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = :'target_schema' ORDER BY c.relname, co.conname;

SELECT t.relname AS table_name, i.relname AS index_name, x.indisvalid, x.indisready
FROM pg_index x JOIN pg_class t ON t.oid = x.indrelid
JOIN pg_class i ON i.oid = x.indexrelid JOIN pg_namespace n ON n.oid = t.relnamespace
WHERE n.nspname = :'target_schema' ORDER BY t.relname, i.relname;

SELECT schemaname, sequencename, start_value, increment_by, last_value
FROM pg_sequences WHERE schemaname = :'target_schema' ORDER BY sequencename;
-- Also compare each sequence with MAX(its owning column), and test INSERT later
-- in isolation. last_value may be NULL without sequence privileges / when unused.

SELECT event_object_table, trigger_name, action_timing, event_manipulation, action_statement
FROM information_schema.triggers WHERE trigger_schema = :'target_schema';
COMMIT;
